# Set these through environment variables before using signing/notarization lanes:
#   FASTLANE_APP_IDENTIFIER
#   FASTLANE_APPLE_ID
#   FASTLANE_TEAM_ID
app_identifier(ENV.fetch("FASTLANE_APP_IDENTIFIER", "io.playcover.PlayCover")) # The bundle identifier of your app
apple_id(ENV["FASTLANE_APPLE_ID"]) if ENV["FASTLANE_APPLE_ID"] # Your Apple email address
team_id(ENV["FASTLANE_TEAM_ID"]) if ENV["FASTLANE_TEAM_ID"] # Developer Portal Team ID

